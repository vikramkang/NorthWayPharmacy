# Copy to .env and fill in for your environment. .env is gitignored.

PORT=4000

# Comma-separated list of origins allowed to call this API.
# In dev, "*" (via CORS_ALLOW_ALL=true) is simplest. Lock this down before
# any public deployment — see ProjectDocs/Rules.md.
CORS_ALLOW_ALL=true
FRONTEND_ORIGIN=http://localhost:8080

# Local-dev-only route to view queued registration submissions without a
# real staff UI. Leave unset/false anywhere but your own machine.
ENABLE_DEV_PENDING_ROUTE=true

# Shared secret for the Team admin page (add/edit/remove provider bios).
# This is a single shared password, not per-user accounts — enough to keep
# random visitors out, not a substitute for real auth if this ever handles
# anything more sensitive than public marketing bios. Set a real random
# value before deploying anywhere public; without it, admin editing is
# disabled entirely (the API returns 503).
ADMIN_TOKEN=change-me-before-deploying
