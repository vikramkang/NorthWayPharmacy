# Copy to .env and fill in for your environment. .env is gitignored.

PORT=4000

# Comma-separated list of origins allowed to call this API.
# In dev, "*" (via CORS_ALLOW_ALL=true) is simplest. Lock this down before
# any public deployment — see ProjectDocs/Rules.md.
CORS_ALLOW_ALL=true
FRONTEND_ORIGIN=http://localhost:8080

# Local-dev-only route to view queued registration submissions without a
# real staff UI. Leave unset/false anywhere but your own machine.
ENABLE_DEV_PENDING_ROUTE=true
